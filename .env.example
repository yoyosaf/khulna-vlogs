# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application (used for sitemap.xml, canonical tags, and OpenGraph URLs).
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of Google account emails authorized to access the Khulna Vlogs Admin Dashboard.
# If left unset, the first authenticated user who signs in becomes the initial administrator.
ADMIN_EMAILS="admin@example.com"
